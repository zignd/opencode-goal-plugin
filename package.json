{
  "name": "opencode-goal-plugin",
  "version": "1.2.0",
  "description": "Persistent /goal command for OpenCode 2: set a standing goal and keep working until it is done, blocked, stalled, or out of turns",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./tui.ts"
  },
  "files": [
    "index.ts",
    "tui.ts",
    "src",
    "tsconfig.json"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "goal",
    "ralph-loop",
    "autonomous"
  ],
  "license": "MIT",
  "author": "Igor Hip\u00f3lito Vieira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zignd/opencode-goal-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/zignd/opencode-goal-plugin/issues"
  },
  "homepage": "https://github.com/zignd/opencode-goal-plugin#readme",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.18"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "@types/node": "^24.0.0",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3"
  }
}
